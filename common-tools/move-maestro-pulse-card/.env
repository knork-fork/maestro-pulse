# Move Maestro Pulse Card — configuration.
#
# maestro-pulse's own API is unauthenticated and reached over the docker
# network / the host port nginx publishes, so there is no credential to
# configure — just the base URL. Real overrides (if the host port ever
# differs) go in .env.local, which is gitignored and loaded after this file.

MAESTRO_PULSE_BASE_URL=http://localhost:20444
